# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/


# Project data — never commit real user logs or scoring DBs. Runtime data lives outside the checkout
# by default (see monitor/paths.py); these patterns are the safety net if it ever lands in here.
logs/
inspect_logs/
*.db
*.db-*
*.sqlite
*.sqlite3
allowlist.json
# Real session logs. The committed fixtures are the only exceptions.
*.jsonl
!tests/fixtures/*.jsonl
!samples/*.jsonl
!benchmark/sessions/*.jsonl

# Node / frontend
node_modules/
dist/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Claude Code per-user settings (project settings.json is committed)
.claude/settings.local.json

# varlock — encrypted local secrets (never commit)
.env.local
.coverage
